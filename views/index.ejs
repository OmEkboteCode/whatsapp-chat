<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="style.css"/>
</head>
<body>
    <main class="container">
        <header>
            <h2>WhatsApp!</h2>
            <p>All your chats</p>
        </header>
        <div class="top-bar">
            <h4>All Chats</h4>

            <form method="GET" action="/chats/new">
                <button class="new-chat">New Chat</button>
            </form>
        </div>
        <section class="chat-list">
            <% for(let chat of chats) { %>
                <article class="chat">
                    <div class="chat-header">
                        <span>From: <b><%= chat.from  %></b></span>
                        <span>To: <b><%= chat.to  %></b></span>
                    </div>
                    <p class="message">
                        <%= chat.message %>
                    </p>
                    <div class="chat-footer">
                        <Span>
                            <%= chat.created_at.toString().split(" ")[4] %>
                        </Span>
                        <Span>
                            <%= chat.created_at.toString().split(" ").slice(0,4).join("-") %>
                        </Span>
                    </div>
                    <div class="action">
                        <form method="GET" action="/chats/<%= chat._id %>/edit">
                            <button class="edit">Edit</button>
                        </form>
                        <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                            <button class="delete">Delete</button>
                        </form>
                    </div>
                </article>
            <% } %>
        </section>
    </main>

</body>
</html>




